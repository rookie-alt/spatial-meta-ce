<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: 'Source Han Sans SC', display: 'flex', flexDirection: 'column', justifyContent: 'space-between' }}>
  <Box style={{ height: 68, borderBottom: '1px solid #D6DCE5', justifyContent: 'space-between' }}>
    <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-start' }}>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1A2230' }}>跨数据库零样本结果</Text>
      <Text style={{ fontSize: 14, color: '#1E4FA8', fontWeight: 'bold' }}>07 / 10</Text>
    </Box>
    <Text style={{ fontSize: 16, color: '#4A5568' }}>轻量ERM-sum，K = 0；全量unique-query Q95，越低越好</Text>
  </Box>

  <Box style={{ height: 460, flexDirection: 'column', gap: 24 }}>
    <Box style={{ height: 330, flexDirection: 'row', gap: 24 }}>
      <Table
        style={{ width: 760, height: 330 }}
        defaultTextStyle={{ fontSize: 19, textAlign: 'center', color: '#1A2230', fontFamily: 'Source Han Sans SC' }}
        defaultCellStyle={{ padding: 8, border: { left: { width: 1, color: '#D6DCE5' }, right: { width: 1, color: '#D6DCE5' }, top: { width: 1, color: '#D6DCE5' }, bottom: { width: 1, color: '#D6DCE5' } } }}
        cells={[
          [{ text: '目标数据库', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#0E3F8C' } } }, { text: 'PG', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#0E3F8C' } } }, { text: 'PRICE', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#0E3F8C' } } }, { text: 'ERM-sum', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#0E3F8C' } } }],
          ['IMDB', '87.11', '21.03', { text: '33.13 ± 1.79', textStyle: { bold: true, color: '#1E4FA8' }, cellStyle: { background: { color: '#F0F5FC' } } }],
          [{ text: 'STATS', cellStyle: { background: { color: '#F7F9FC' } } }, { text: '75.65', cellStyle: { background: { color: '#F7F9FC' } } }, { text: '39.52', cellStyle: { background: { color: '#F7F9FC' } } }, { text: '81.07 ± 2.44', cellStyle: { background: { color: '#F7F9FC' } } }],
          ['Genome', '1907.32', '31.34', { text: '192.01 ± 122.70', textStyle: { bold: true, color: '#1E4FA8' }, cellStyle: { background: { color: '#F0F5FC' } } }],
          [{ text: 'ErgastF1', cellStyle: { background: { color: '#F7F9FC' } } }, { text: '27.61', cellStyle: { background: { color: '#F7F9FC' } } }, { text: '15.29', cellStyle: { background: { color: '#F7F9FC' } } }, { text: '23.44 ± 1.54', textStyle: { bold: true, color: '#1E4FA8' }, cellStyle: { background: { color: '#F7F9FC' } } }]
        ]}
      />

      <Box style={{ width: 376, height: 330, flexDirection: 'column', gap: 20 }}>
        <Box style={{ height: 155, background: '#E8EFF8', borderRadius: 8, padding: 20, justifyContent: 'center', gap: 6 }}>
          <Text style={{ fontSize: 44, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1.1 }}>3 / 4</Text>
          <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1A2230' }}>目标库优于PG基线</Text>
          <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.4 }}>IMDB、Genome、ErgastF1的Q95明显下降</Text>
        </Box>
        <Box style={{ height: 155, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 8, padding: 20, justifyContent: 'center', gap: 6 }}>
          <Text style={{ fontSize: 44, fontWeight: 'bold', color: '#D9534F', lineHeight: 1.1 }}>0 / 4</Text>
          <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1A2230' }}>目标库超过PRICE</Text>
          <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.4 }}>尾部估计与跨库迁移精度仍待改善</Text>
        </Box>
      </Box>
    </Box>

    <Box style={{ height: 106, background: '#F0F5FC', borderRadius: 8, padding: '16px 24px', justifyContent: 'center', gap: 8 }}>
      <Text style={{ fontSize: 22, color: '#0E3F8C', fontWeight: 'bold', textAlign: 'center' }}>轻量方案已验证可行性，但尚未形成对PRICE的精度优势</Text>
      <Text style={{ fontSize: 16, color: '#4A5568', textAlign: 'center', lineHeight: 1.4 }}>ERM-sum为三次训练均值±标准差；PRICE为26源库预训练参考，本模型为23源库训练。下一步通过误差诊断、结构锚点与适应机制分析改进尾部误差。</Text>
    </Box>
  </Box>

  <Box style={{ height: 20, flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#8B97A8' }}>魏林｜硕士学位论文中期汇报</Text>
